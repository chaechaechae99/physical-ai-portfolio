+    def fetch_transcript(video_url: str, languages: List[str]) -> str:
+        """Fetch a transcript with youtube-transcript-api >= 1.0 (the old static API used by YoutubeLoader is gone)."""
+        video_id = YoutubeLoader.extract_video_id(video_url)
+        api = YouTubeTranscriptApi()
+        try:
+            transcript_list = api.list(video_id)
+        except TranscriptsDisabled:
+            return ""
+        try:
+            transcript = transcript_list.find_transcript(languages)
+        except NoTranscriptFound:
+            transcript = next(iter(transcript_list), None)
+            if transcript is None:
+                return ""
+        return " ".join(snippet.text.strip() for snippet in transcript.fetch())
+
